generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  BUSINESS_OWNER
  STAFF
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
}

enum BankAccountStatus {
  ACTIVE
  INACTIVE
}

enum BankConnectionStatus {
  CONNECTED
  DISCONNECTED
  PENDING
}

enum RoomStatus {
  AVAILABLE
  DEPOSITED
  OCCUPIED
  MAINTENANCE
  INACTIVE
}

enum TenantStatus {
  DEPOSITED
  STAYING
  LEFT
}

enum ContractStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  TERMINATED
}

enum PaymentCycle {
  MONTHLY
  QUARTERLY
  CUSTOM
}

enum OccupantType {
  ADULT
  CHILD
  ELDERLY
}

enum OccupantStatus {
  DEPOSITED
  STAYING
  LEFT
}

enum BillingPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum ChargeType {
  ROOM_RENT
  DEPOSIT
  ELECTRICITY
  WATER
  PARKING
  INTERNET
  GARBAGE
  CLEANING
  DAMAGE_FEE
  OTHER
}

enum ChargeStatus {
  UNPAID
  PARTIAL
  PAID
  OVERPAID
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CREDIT
}

enum PaymentStatus {
  CONFIRMED
  CANCELLED
}

enum TransactionType {
  IN
  OUT
}

enum CreditLedgerType {
  OVERPAYMENT
  APPLY_TO_CHARGE
  REFUND
}

enum CreditLedgerStatus {
  POSTED
  VOIDED
}

enum TenantCreditActivityType {
  APPLY_TO_CHARGE
  REFUND
}

enum TenantCreditActivityStatus {
  POSTED
  VOIDED
}

enum RefundMethod {
  CASH
  BANK_TRANSFER
}

enum TransactionClassification {
  RENT_MATCHED
  SUSPICIOUS
  OTHER
}

enum PaymentMatchStatus {
  AUTO_MATCHED
  MANUAL_MATCHED
  NEEDS_REVIEW
  REJECTED
  IGNORED
}

enum NotificationAction {
  CREATED
  COPIED
  SHARED_MANUALLY
  DOWNLOADED_QR
  PUBLIC_LOOKUP
  PUBLIC_QR_VIEWED
  PUBLIC_TRANSFER_CONTENT_COPIED
}

model User {
  id                String            @id @default(cuid())
  fullName          String
  phone             String            @unique
  passwordHash      String
  role              Role
  businessId        String?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  business          Business?         @relation(fields: [businessId], references: [id])
  sessions          AuthSession[]
  auditLogs         AuditLog[]        @relation("AuditUser")
  billingPeriodsCreated BillingPeriod[] @relation("BillingPeriodCreator")
  collectedPayments Payment[]         @relation("PaymentCollector")
  reviewedPaymentMatches PaymentMatch[] @relation("PaymentMatchReviewer")
  notificationLogs  NotificationLog[] @relation("NotificationCreator")
  tenantCreditActivities TenantCreditActivity[] @relation("TenantCreditActivityCreator")

  @@index([businessId])
  @@index([role])
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model Business {
  id               String            @id @default(cuid())
  businessName     String
  businessSlug     String            @unique
  taxCode          String?
  ownerName        String
  address          String?
  status           BusinessStatus    @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  users            User[]
  bankAccounts     BankAccount[]
  bankConnections  BankConnection[]
  roomAreas        RoomArea[]
  rooms            Room[]
  tenants          Tenant[]
  contracts        RentalContract[]
  contractRooms    RentalContractRoom[]
  occupants        ContractOccupant[]
  billingPeriods   BillingPeriod[]
  charges          Charge[]
  chargeItems      ChargeItem[]
  payments         Payment[]
  creditLedgers    CreditLedger[]
  creditActivities TenantCreditActivity[]
  transactions     BankTransaction[]
  matches          PaymentMatch[]
  notificationLogs NotificationLog[]
  auditLogs        AuditLog[]

  @@index([status])
}

model BankAccount {
  id             String            @id @default(cuid())
  businessId     String
  bankName       String
  bankCode       String
  accountNumber  String
  accountName    String
  isDefault      Boolean           @default(false)
  status         BankAccountStatus @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  business       Business          @relation(fields: [businessId], references: [id])
  connections    BankConnection[]
  charges        Charge[]
  transactions   BankTransaction[]
  refundCreditActivities TenantCreditActivity[] @relation("RefundOwnerBankAccount")

  @@index([businessId])
  @@index([bankCode])
}

model BankConnection {
  id                    String               @id @default(cuid())
  businessId            String
  bankAccountId         String
  bankCode              String
  provider              String
  status                BankConnectionStatus @default(PENDING)
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  business              Business             @relation(fields: [businessId], references: [id])
  bankAccount           BankAccount          @relation(fields: [bankAccountId], references: [id])

  @@index([businessId])
  @@index([bankAccountId])
}

model RoomArea {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id])
  rooms       Room[]

  @@unique([businessId, name])
  @@index([businessId])
}

model Room {
  id             String             @id @default(cuid())
  businessId     String
  roomAreaId     String
  roomCode       String
  area           Decimal?           @db.Decimal(10, 2)
  baseRentAmount Decimal            @db.Decimal(14, 2)
  depositAmount  Decimal?           @db.Decimal(14, 2)
  maxOccupants   Int?
  currentOccupantCount Int           @default(0)
  status         RoomStatus         @default(AVAILABLE)
  note           String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  business       Business           @relation(fields: [businessId], references: [id])
  roomArea       RoomArea           @relation(fields: [roomAreaId], references: [id])
  contracts      RentalContract[]
  contractRooms  RentalContractRoom[]
  occupants      ContractOccupant[]
  charges        Charge[]
  payments       Payment[]
  creditLedgers  CreditLedger[]
  creditActivities TenantCreditActivity[]
  notificationLogs NotificationLog[]

  @@unique([businessId, roomAreaId, roomCode])
  @@index([businessId, status])
  @@index([roomAreaId])
}

model Tenant {
  id                    String             @id @default(cuid())
  businessId            String
  fullName              String
  phone                 String
  identityNumber        String
  dateOfBirth           DateTime?          @db.Date
  permanentAddress      String
  note                  String?
  status                TenantStatus       @default(DEPOSITED)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  business              Business           @relation(fields: [businessId], references: [id])
  representedContracts  RentalContract[]   @relation("RepresentativeTenant")
  charges               Charge[]
  payments              Payment[]
  creditLedgers         CreditLedger[]
  creditActivities      TenantCreditActivity[]
  notificationLogs      NotificationLog[]

  @@index([businessId, status])
  @@index([phone])
}

model RentalContract {
  id                     String             @id @default(cuid())
  businessId             String
  roomId                 String
  representativeTenantId String
  startDate              DateTime           @db.Date
  endDate                DateTime?          @db.Date
  reason                 Json?
  rentAmount             Decimal            @db.Decimal(14, 2)
  depositAmount          Decimal            @db.Decimal(14, 2)
  paymentCycle           PaymentCycle       @default(MONTHLY)
  paymentDueDay          Int
  status                 ContractStatus     @default(PENDING)
  note                   String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  business               Business           @relation(fields: [businessId], references: [id])
  room                   Room               @relation(fields: [roomId], references: [id])
  representativeTenant   Tenant             @relation("RepresentativeTenant", fields: [representativeTenantId], references: [id])
  contractRooms          RentalContractRoom[]
  occupants              ContractOccupant[]
  charges                Charge[]
  payments               Payment[]
  creditLedgers          CreditLedger[]
  creditActivities       TenantCreditActivity[]

  @@index([businessId, status])
  @@index([roomId, status])
}

model RentalContractRoom {
  id         String         @id @default(cuid())
  businessId String
  contractId String
  roomId     String
  createdAt  DateTime       @default(now())
  business   Business       @relation(fields: [businessId], references: [id])
  contract   RentalContract @relation(fields: [contractId], references: [id])
  room       Room           @relation(fields: [roomId], references: [id])

  @@unique([contractId, roomId])
  @@index([businessId])
  @@index([roomId])
}

model ContractOccupant {
  id           String         @id @default(cuid())
  businessId   String
  contractId   String
  roomId       String
  fullName     String
  phone        String?
  identityNumber String?
  dateOfBirth  DateTime?      @db.Date
  permanentAddress String?
  occupantType OccupantType
  relationship String?
  moveInDate   DateTime       @db.Date
  moveOutDate  DateTime?      @db.Date
  status       OccupantStatus @default(DEPOSITED)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  business     Business       @relation(fields: [businessId], references: [id])
  contract     RentalContract @relation(fields: [contractId], references: [id])
  room         Room           @relation(fields: [roomId], references: [id])

  @@index([businessId, status])
  @@index([contractId, occupantType])
}

model BillingPeriod {
  id        String              @id @default(cuid())
  businessId String
  createdBy String?
  month     Int
  year      Int
  startDate DateTime
  endDate   DateTime
  status    BillingPeriodStatus @default(OPEN)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  business  Business            @relation(fields: [businessId], references: [id])
  creator   User?               @relation("BillingPeriodCreator", fields: [createdBy], references: [id])
  charges   Charge[]

  @@unique([businessId, month, year])
  @@index([businessId, status])
  @@index([createdBy])
}

model Charge {
  id              String          @id @default(cuid())
  businessId      String
  roomId          String
  contractId      String?
  payerTenantId   String?
  billingPeriodId String?
  bankAccountId   String
  chargeType      ChargeType
  title           String
  amountDue       Decimal         @db.Decimal(14, 2)
  amountPaid      Decimal         @default(0) @db.Decimal(14, 2)
  dueDate         DateTime?
  paymentCode     String          @unique
  transferContent String
  paymentLink     String?
  status          ChargeStatus    @default(UNPAID)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  business        Business        @relation(fields: [businessId], references: [id])
  room            Room            @relation(fields: [roomId], references: [id])
  contract        RentalContract? @relation(fields: [contractId], references: [id])
  payerTenant     Tenant?         @relation(fields: [payerTenantId], references: [id])
  billingPeriod   BillingPeriod?  @relation(fields: [billingPeriodId], references: [id])
  bankAccount     BankAccount     @relation(fields: [bankAccountId], references: [id])
  items           ChargeItem[]
  payments        Payment[]
  matches         PaymentMatch[]
  sourceCreditLedgers CreditLedger[] @relation("SourceChargeCreditLedgers")
  targetCreditLedgers CreditLedger[] @relation("TargetChargeCreditLedgers")
  sourceCreditActivities TenantCreditActivity[] @relation("SourceChargeCreditActivities")
  targetCreditActivities TenantCreditActivity[] @relation("TargetChargeCreditActivities")
  notificationLogs NotificationLog[]

  @@index([businessId, status])
  @@index([roomId])
  @@index([contractId, billingPeriodId])
}

model ChargeItem {
  id          String     @id @default(cuid())
  businessId  String
  chargeId    String
  chargeType  ChargeType
  title       String
  amount      Decimal    @db.Decimal(14, 2)
  note        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  business    Business   @relation(fields: [businessId], references: [id])
  charge      Charge     @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@index([businessId, chargeType])
  @@index([chargeId])
}

model Payment {
  id                String         @id @default(cuid())
  businessId        String
  chargeId          String
  roomId            String
  contractId        String?
  tenantId          String?
  method            PaymentMethod
  amount            Decimal        @db.Decimal(14, 2)
  paidAt            DateTime
  collectedBy       String?
  bankTransactionId String?
  note              String?
  status            PaymentStatus  @default(CONFIRMED)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  business          Business       @relation(fields: [businessId], references: [id])
  charge            Charge         @relation(fields: [chargeId], references: [id])
  room              Room           @relation(fields: [roomId], references: [id])
  contract          RentalContract? @relation(fields: [contractId], references: [id])
  tenant            Tenant?        @relation(fields: [tenantId], references: [id])
  collector         User?          @relation("PaymentCollector", fields: [collectedBy], references: [id])
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id])
  sourceCreditLedgers CreditLedger[] @relation("SourcePaymentCreditLedgers")
  targetCreditLedgers CreditLedger[] @relation("TargetPaymentCreditLedgers")

  @@index([businessId, method, status])
  @@index([chargeId])
  @@index([paidAt])
}

model BankTransaction {
  id              String                    @id @default(cuid())
  businessId      String
  bankAccountId   String
  bankCode        String
  accountNumber   String
  transactionRef  String
  amount          Decimal                   @db.Decimal(14, 2)
  description     String
  transactionTime DateTime
  type            TransactionType           @default(IN)
  classification  TransactionClassification @default(OTHER)
  rawData         Json
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  business        Business                  @relation(fields: [businessId], references: [id])
  bankAccount     BankAccount               @relation(fields: [bankAccountId], references: [id])
  payments        Payment[]
  matches         PaymentMatch[]
  creditLedgers   CreditLedger[]
  creditActivities TenantCreditActivity[]

  @@unique([bankAccountId, transactionRef])
  @@index([businessId, classification])
  @@index([transactionTime])
}

model PaymentMatch {
  id          String             @id @default(cuid())
  businessId  String
  transactionId String
  chargeId    String?
  matchStatus PaymentMatchStatus
  confidence  Int
  reason      Json
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  reviewDecision Json?
  createdAt   DateTime           @default(now())
  business    Business           @relation(fields: [businessId], references: [id])
  transaction BankTransaction    @relation(fields: [transactionId], references: [id])
  charge      Charge?            @relation(fields: [chargeId], references: [id])
  reviewer    User?              @relation("PaymentMatchReviewer", fields: [reviewedBy], references: [id])

  @@index([businessId, matchStatus])
  @@index([reviewedBy])
}

model CreditLedger {
  id                     String             @id @default(cuid())
  activityId             String?
  businessId             String
  tenantId               String?
  contractId             String?
  roomId                 String
  sourceChargeId         String?
  targetChargeId         String?
  sourcePaymentId        String?
  targetPaymentId        String?
  bankTransactionId      String?
  type                   CreditLedgerType
  status                 CreditLedgerStatus @default(POSTED)
  amount                 Decimal            @db.Decimal(14, 2)
  refundMethod           RefundMethod?
  recipientBankName      String?
  recipientAccountNumber String?
  recipientAccountName   String?
  transferContent        String?
  transferredAt          DateTime?
  bankMatchedAt          DateTime?
  note                   String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  business               Business           @relation(fields: [businessId], references: [id])
  tenant                 Tenant?            @relation(fields: [tenantId], references: [id])
  contract               RentalContract?    @relation(fields: [contractId], references: [id])
  room                   Room               @relation(fields: [roomId], references: [id])
  sourceCharge           Charge?            @relation("SourceChargeCreditLedgers", fields: [sourceChargeId], references: [id])
  targetCharge           Charge?            @relation("TargetChargeCreditLedgers", fields: [targetChargeId], references: [id])
  sourcePayment          Payment?           @relation("SourcePaymentCreditLedgers", fields: [sourcePaymentId], references: [id])
  targetPayment          Payment?           @relation("TargetPaymentCreditLedgers", fields: [targetPaymentId], references: [id])
  bankTransaction        BankTransaction?   @relation(fields: [bankTransactionId], references: [id])
  activity               TenantCreditActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([activityId])
  @@index([businessId, tenantId])
  @@index([businessId, contractId])
  @@index([businessId, roomId])
  @@index([sourceChargeId, status])
  @@index([targetChargeId])
  @@index([sourcePaymentId, status])
  @@index([targetPaymentId, status])
  @@index([bankTransactionId])
  @@index([type, status])
}

model TenantCreditActivity {
  id                     String                     @id @default(cuid())
  activityCode           String                     @unique
  businessId             String
  tenantId               String?
  contractId             String?
  roomId                 String
  sourceChargeId         String?
  targetChargeId         String?
  ownerBankAccountId     String?
  bankTransactionId      String?
  type                   TenantCreditActivityType
  status                 TenantCreditActivityStatus @default(POSTED)
  amount                 Decimal                    @db.Decimal(14, 2)
  refundMethod           RefundMethod?
  recipientBankName      String?
  recipientAccountNumber String?
  recipientAccountName   String?
  transferContent        String?
  transferredAt          DateTime?
  bankMatchedAt          DateTime?
  note                   String?
  createdBy              String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  business               Business                   @relation(fields: [businessId], references: [id])
  tenant                 Tenant?                    @relation(fields: [tenantId], references: [id])
  contract               RentalContract?            @relation(fields: [contractId], references: [id])
  room                   Room                       @relation(fields: [roomId], references: [id])
  sourceCharge           Charge?                    @relation("SourceChargeCreditActivities", fields: [sourceChargeId], references: [id])
  targetCharge           Charge?                    @relation("TargetChargeCreditActivities", fields: [targetChargeId], references: [id])
  creator                User?                      @relation("TenantCreditActivityCreator", fields: [createdBy], references: [id])
  ownerBankAccount       BankAccount?               @relation("RefundOwnerBankAccount", fields: [ownerBankAccountId], references: [id])
  bankTransaction        BankTransaction?           @relation(fields: [bankTransactionId], references: [id])
  ledgers                CreditLedger[]

  @@index([businessId, tenantId])
  @@index([businessId, contractId])
  @@index([businessId, roomId])
  @@index([sourceChargeId])
  @@index([targetChargeId])
  @@index([ownerBankAccountId])
  @@index([bankTransactionId])
  @@index([createdBy])
  @@index([type, status])
  @@index([refundMethod])
  @@index([createdAt])
}

model NotificationLog {
  id         String             @id @default(cuid())
  businessId String
  chargeId   String?
  tenantId   String?
  roomId     String?
  action     NotificationAction
  createdBy  String?
  createdAt  DateTime           @default(now())
  metadata   Json?
  business   Business           @relation(fields: [businessId], references: [id])
  charge     Charge?            @relation(fields: [chargeId], references: [id])
  tenant     Tenant?            @relation(fields: [tenantId], references: [id])
  room       Room?              @relation(fields: [roomId], references: [id])
  creator    User?              @relation("NotificationCreator", fields: [createdBy], references: [id])

  @@index([businessId, action])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String?
  userId     String?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  business   Business? @relation(fields: [businessId], references: [id])
  user       User?    @relation("AuditUser", fields: [userId], references: [id])

  @@index([businessId, action])
  @@index([entity, entityId])
  @@index([createdAt])
}
